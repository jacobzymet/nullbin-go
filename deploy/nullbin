#!/usr/bin/env bash
# Nullbin server helper. Run it with sudo from the deploy folder:
#
#   sudo ./nullbin setup paste.example.com    configure the one-server layout
#   sudo ./nullbin setup-api api.example.com https://paste.example.com
#                                             configure the separate-API layout
#        (add --cloudflare to either when Cloudflare's proxy is in front)
#   sudo ./nullbin cloudflare on    Cloudflare's proxy is in front (off: it is not)
#   sudo ./nullbin cloudflare       Cloudflare mode and certificate status
#   sudo ./nullbin start            build and start the installed release
#   sudo ./nullbin update           update to the latest release
#   sudo ./nullbin update v1.2.3    switch to a specific release (or back to one)
#   sudo ./nullbin status           installed version and container status
#   sudo ./nullbin logs             recent logs
#   sudo ./nullbin stop             stop Nullbin (pastes are kept)
#   sudo ./nullbin delete <id>      remove a reported paste by its ID
#   sudo ./nullbin cleanup          free disk space used by old builds
#
# Option A uses deploy/.env and Option B deploy/.env.api; every command picks
# the right one. Git and all file changes run as the owner of the checkout,
# so sudo never leaves root-owned files behind.
#
# Whoever can change this checkout controls what runs as root here, as with
# any Docker Compose setup: keep it owned and writable by you alone.
set -euo pipefail

# Everything runs inside main, which bash reads completely before running:
# "update" replaces this file with the new release's copy while it runs.
main() {
  local deploy repo owner
  deploy=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  repo=$(dirname -- "$deploy")

  die() { echo "nullbin: $*" >&2; exit 1; }

  [[ $# -ge 1 ]] || { usage; exit 2; }
  local cmd=$1
  shift
  [[ $cmd == help || $cmd == -h || $cmd == --help ]] && { usage; exit 0; }
  [[ $EUID -eq 0 ]] || die "run it with sudo: sudo ./nullbin $cmd $*"
  [[ -d $repo/.git ]] || die "$repo is not a Git checkout of Nullbin"

  # Runs a command as the checkout's owner. Every file this script reads,
  # creates or changes inside the checkout goes through it: as root, a link
  # planted there could redirect the operation to a system file. Git runs
  # this way too, so the files it writes stay the owner's.
  owner=$(stat -c %U -- "$repo/.git")
  as_owner() {
    if [[ $owner == root ]]; then
      "$@"
    else
      sudo -u "$owner" -- "$@"
    fi
  }
  g() { as_owner git -C "$repo" "$@"; }

  # IPv6 on the public network keeps IPv6 visitors' own addresses (see
  # compose.yaml). Docker can create it only where the kernel has IPv6.
  local ipv6=false
  if [[ $(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null) == 0 ]]; then
    ipv6=true
  fi

  # Which layout: Option A (.env) or Option B (.env.api).
  local -a compose=()
  local config=
  # The checked settings, filled by check_config.
  local -A settings=()
  layout() {
    if [[ -f $deploy/.env && -f $deploy/.env.api ]]; then
      die "both deploy/.env and deploy/.env.api exist; remove the one you do not use"
    elif [[ -f $deploy/.env ]]; then
      config=.env
      compose=(docker compose -f "$deploy/compose.yaml")
    elif [[ -f $deploy/.env.api ]]; then
      config=.env.api
      compose=(docker compose --env-file "$deploy/.env.api" -f "$deploy/compose.api.yaml")
    else
      die "not configured yet: run sudo ./nullbin setup paste.example.com (or setup-api for the separate-API layout)"
    fi
    # Settings come only from the checked file, never from this shell, and
    # the project is always "nullbin", whatever the environment says.
    compose=(env -u DOMAIN -u API_DOMAIN -u FRONTEND_ORIGIN -u CLOUDFLARE -u COMPOSE_PROJECT_NAME -u COMPOSE_FILE
      -u COMPOSE_ENV_FILES -u COMPOSE_PROFILES "NULLBIN_IPV6=$ipv6" "${compose[@]}" -p nullbin)
    # Stopping always works, even with a broken settings file.
    [[ $cmd == stop ]] || check_config
  }

  # A lowercase domain name with at least one dot, or localhost for testing.
  valid_domain() {
    local d=$1
    [[ $d == localhost ]] && return 0
    [[ ${#d} -le 253 && $d =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?[.])+[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]
  }

  # An exact https:// website address: a domain name and an optional port
  # other than 443, with no path, query or trailing slash.
  valid_origin() {
    local host=${1#https://} port
    [[ $1 == https://* ]] || return 1
    if [[ $host == *:* ]]; then
      port=${host##*:}
      host=${host%:*}
      [[ $port =~ ^[1-9][0-9]{0,4}$ && $port -le 65535 && $port -ne 443 ]] || return 1
    fi
    valid_domain "$host"
  }

  # Checks the whole settings file before Docker Compose reads it. Compose
  # accepts more than NAME=value (NAME: value, quotes, values spanning
  # lines), and a later line overrides an earlier one. Its values reach the
  # proxy's configuration, where a crafted one could add a site that serves
  # other code. So every line must be blank, a comment, or NAME=value with
  # a known name, a plain value and no repeats; then the domains are checked
  # as strictly as setup checks them.
  check_config() {
    local allowed line name
    local -A value=()
    if [[ $config == .env ]]; then
      allowed=" DOMAIN CLOUDFLARE MAX_SIZE MAX_STORAGE MAX_PENDING MAX_PASTES "
    else
      allowed=" API_DOMAIN FRONTEND_ORIGIN CLOUDFLARE MAX_SIZE MAX_STORAGE MAX_PENDING MAX_PASTES "
    fi
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == *[[:cntrl:]]* ]] &&
        die "deploy/$config contains a control character, often from Windows line endings. Save it with Unix (LF) line endings."
      [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
      [[ $line =~ ^([A-Z_]+)=([A-Za-z0-9./:_-]*)$ ]] ||
        die "deploy/$config: each setting must be one line, NAME=value, with nothing else on it (no quotes, spaces or colon form). This line is not: ${line:0:80}"
      name=${BASH_REMATCH[1]}
      [[ $allowed == *" $name "* ]] || die "deploy/$config: $name is not a Nullbin setting"
      [[ -z ${value[$name]+set} ]] || die "deploy/$config sets $name more than once"
      value[$name]=${BASH_REMATCH[2]}
    done < <(as_owner cat -- "$deploy/$config")
    if [[ $config == .env ]]; then
      valid_domain "${value[DOMAIN]:-}" || die "DOMAIN in deploy/.env is not a lowercase domain name such as paste.example.com"
    else
      valid_domain "${value[API_DOMAIN]:-}" || die "API_DOMAIN in deploy/.env.api is not a lowercase domain name such as api.example.com"
      valid_origin "${value[FRONTEND_ORIGIN]:-}" || die "FRONTEND_ORIGIN in deploy/.env.api is not an address such as https://paste.example.com"
    fi
    # It picks a file of the proxy's configuration by name.
    [[ ${value[CLOUDFLARE]:-false} =~ ^(true|false)$ ]] ||
      die "CLOUDFLARE in deploy/$config must be true or false. Change it with: sudo ./nullbin cloudflare on (or off)"
    for name in "${!value[@]}"; do settings[$name]=${value[$name]}; done
  }

  # Sets one setting in the configuration file, replacing its line or
  # adding one, or removes it when the value is empty (NAME=). The file is
  # rewritten by its owner, like every other file change.
  set_setting() {
    local setting=$1 name=${1%%=*} tmp line
    tmp=$(as_owner mktemp "$deploy/.config.XXXXXX")
    if ! as_owner cat -- "$deploy/$config" | while IFS= read -r line || [[ -n $line ]]; do
           if [[ $line == "$name="* ]]; then
             [[ $setting == "$name=" ]] || printf '%s\n' "$setting"
           else
             printf '%s\n' "$line"
           fi
         done | as_owner tee -- "$tmp" >/dev/null; then
      as_owner rm -f -- "$tmp"
      die "could not update deploy/$config"
    fi
    if [[ $setting != "$name=" ]] && ! as_owner grep -q -x -F -- "$setting" "$tmp"; then
      printf '%s\n' "$setting" | as_owner tee -a -- "$tmp" >/dev/null
    fi
    as_owner chmod 600 -- "$tmp"
    as_owner mv -- "$tmp" "$deploy/$config"
  }

  # The domain this server's proxy answers for.
  site_domain() {
    if [[ $config == .env ]]; then echo "${settings[DOMAIN]}"; else echo "${settings[API_DOMAIN]}"; fi
  }

  # Who issued the certificate the proxy presents right now.
  certificate_issuer() {
    local issuer
    command -v openssl >/dev/null || { echo "unknown (openssl is not installed)"; return; }
    issuer=$(timeout 10 openssl s_client -connect 127.0.0.1:443 -servername "$(site_domain)" </dev/null 2>/dev/null |
      openssl x509 -noout -issuer 2>/dev/null || true)
    case $issuer in
      "") echo "none yet (is Nullbin running? It can take a minute after starting)" ;;
      *"Caddy Local Authority"*) echo "Caddy's own (Let's Encrypt has not issued one yet)" ;;
      *"Let's Encrypt"*) echo "Let's Encrypt" ;;
      *) echo "${issuer#issuer=}" ;;
    esac
  }

  # What to set in Cloudflare's dashboard, given the certificate in use.
  cloudflare_status() {
    local issuer
    if [[ ${settings[CLOUDFLARE]:-false} != true ]]; then
      echo "Cloudflare mode: off. Visitors connect to this server directly."
      echo "If Cloudflare's proxy (orange cloud) is in front, run: sudo ./nullbin cloudflare on"
      return
    fi
    issuer=$(certificate_issuer)
    echo "Cloudflare mode: on. Only connections from Cloudflare's addresses are answered."
    echo "Certificate:     $issuer"
    case $issuer in
      "Let's Encrypt") echo "In Cloudflare, set SSL/TLS encryption to: Full (strict)" ;;
      "Caddy's own"*)
        echo "In Cloudflare, set SSL/TLS encryption to: Full (not Full (strict), until Let's Encrypt issues one)"
        echo "Caddy tries Let's Encrypt again about every 40 minutes; it needs this server's port 80 open"
        echo "to Cloudflare. Check again later with: sudo ./nullbin cloudflare" ;;
    esac
  }

  # Copies standard input to standard output, replacing whole lines that
  # start with a setting's name (such as DOMAIN=) by that setting.
  render_config() {
    local line setting
    while IFS= read -r line || [[ -n $line ]]; do
      for setting in "$@"; do
        if [[ $line == "${setting%%=*}="* ]]; then
          line=$setting
        fi
      done
      printf '%s\n' "$line"
    done
  }

  # Writes a configuration file from its example with the given settings.
  # The file belongs to the checkout's owner and only they can read it.
  write_config() {
    local example=$1 target=$2
    shift 2
    [[ ! -e $deploy/.env && ! -e $deploy/.env.api ]] ||
      die "already configured: edit deploy/.env or deploy/.env.api, or delete it to start over"
    local tmp setting found
    # Only the text passes through root; every file operation is the owner's.
    tmp=$(as_owner mktemp "$deploy/.config.XXXXXX")
    if ! as_owner cat -- "$deploy/$example" | render_config "$@" | as_owner tee -- "$tmp" >/dev/null; then
      as_owner rm -f -- "$tmp"
      die "could not read $example"
    fi
    # Settings the example only describes in a comment (such as CLOUDFLARE)
    # are added at the end.
    for setting in "$@"; do
      if ! as_owner grep -q -- "^${setting%%=*}=" "$tmp"; then
        printf '%s\n' "$setting" | as_owner tee -a -- "$tmp" >/dev/null
      fi
    done
    for setting in "$@"; do
      found=$(as_owner grep -c -F -x -- "$setting" "$tmp" || true)
      [[ $found -eq 1 ]] || { as_owner rm -f -- "$tmp"; die "could not set ${setting%%=*} in $example"; }
    done
    as_owner chmod 600 -- "$tmp"
    as_owner mv -- "$tmp" "$deploy/$target"
    echo "Wrote deploy/$target. To change settings later, edit it and run: sudo ./nullbin start"
  }

  installed() { g describe --tags --always 2>/dev/null || echo unknown; }

  # The version the running API was built from, from its image label.
  running() {
    local id v
    id=$("${compose[@]}" ps -q nullbin 2>/dev/null || true)
    [[ -n $id ]] || { echo "not running"; return; }
    v=$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$id" 2>/dev/null || true)
    [[ -n $v && $v != "<no value>" ]] && echo "$v" || echo "unknown (started before v0.2.6)"
  }

  # Files that would be built into Nullbin but did not come with the
  # release: edits, added files, and files Git ignores inside the folders
  # the build copies (except the build's own output).
  local_changes() {
    g status --porcelain --untracked-files=all
    g ls-files --others --ignored --exclude-standard -- cmd internal web Dockerfile go.mod \
      package.json package-lock.json tsconfig.json .npmrc |
      grep -v -E '^(internal/assets/dist/|web/dist/|web/generated/)' | sed 's/^/!! /' || true
  }

  start() {
    local version changes
    version=$(installed)
    # Configurations from before v0.2.5 hold the old default of 64, which a
    # few client networks could fill with empty uploads.
    if as_owner grep -q -x -- 'MAX_PENDING=64' "$deploy/$config"; then
      as_owner sed -i -- 's/^MAX_PENDING=64$/MAX_PENDING=1024/' "$deploy/$config"
      echo "Raised MAX_PENDING in deploy/$config from the old default 64 to the new default 1024."
    fi
    changes=$(local_changes)
    [[ -z $changes ]] || echo "Note: these files did not come with Nullbin and will be built in:
$changes" >&2
    g describe --tags --exact-match --match 'v[0-9]*.[0-9]*.[0-9]*' >/dev/null 2>&1 ||
      echo "Note: $version is not a release. To install one: sudo ./nullbin update" >&2
    echo "Building and starting Nullbin $version. The first build takes a few minutes."
    VERSION=$version "${compose[@]}" up -d --build --remove-orphans --wait --wait-timeout 600
    echo "Nullbin $version is running."
    if [[ ${settings[CLOUDFLARE]:-false} == true && $cmd != cloudflare ]]; then
      echo "Cloudflare mode is on. For its certificate and Cloudflare's SSL setting, run: sudo ./nullbin cloudflare"
    fi
  }

  # owner/name of the GitHub repository this checkout came from.
  repo_slug() {
    local url slug
    url=$(g remote get-url origin)
    url=${url%.git}
    url=${url%/}
    slug=${url#https://github.com/}
    slug=${slug#git@github.com:}
    [[ $slug =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
    echo "$slug"
  }

  latest_release() {
    local slug
    slug=$(repo_slug) || return 1
    curl -fsSL "https://api.github.com/repos/$slug/releases/latest" |
      grep -o '"tag_name": *"[^"]*"' | head -n 1 | cut -d '"' -f 4
  }

  # The HTTP status GitHub gives for a release with this tag: 200 if it is
  # published, 404 if not, anything else (000 = no connection) if unknown.
  release_status() {
    local slug
    slug=$(repo_slug) || { echo 000; return; }
    curl -s -o /dev/null -w '%{http_code}' --max-time 20 "https://api.github.com/repos/$slug/releases/tags/$1" || true
  }

  case $cmd in
    setup)
      local domain=${1:-} cloudflare=()
      domain=${domain,,}
      valid_domain "$domain" ||
        die "give your domain name only, such as: sudo ./nullbin setup paste.example.com (no https:// and no slash)"
      case $# in
        1) ;;
        2) [[ $2 == --cloudflare ]] || die "unknown option $2 (did you mean --cloudflare?)"; cloudflare=(CLOUDFLARE=true) ;;
        *) die "usage: sudo ./nullbin setup paste.example.com [--cloudflare]" ;;
      esac
      write_config env.example .env "DOMAIN=$domain" "${cloudflare[@]}"
      if [[ ${#cloudflare[@]} -gt 0 ]]; then
        echo "Cloudflare mode is on. Next: in Cloudflare, add a proxied (orange cloud) DNS record for $domain"
        echo "pointing at this server, then run: sudo ./nullbin start"
      else
        echo "Next: point $domain at this server, then run: sudo ./nullbin start"
      fi
      ;;
    setup-api)
      local api=${1:-} origin=${2:-} cloudflare=()
      api=${api,,}
      origin=${origin,,}
      valid_domain "$api" ||
        die "usage: sudo ./nullbin setup-api api.example.com https://paste.example.com (the API's domain name, then the website's exact address)"
      valid_origin "$origin" ||
        die "the website address must be https:// and a domain name, with no path or trailing slash and no :443, such as https://paste.example.com"
      case $# in
        2) ;;
        3) [[ $3 == --cloudflare ]] || die "unknown option $3 (did you mean --cloudflare?)"; cloudflare=(CLOUDFLARE=true) ;;
        *) die "usage: sudo ./nullbin setup-api api.example.com https://paste.example.com [--cloudflare]" ;;
      esac
      write_config env.api.example .env.api "API_DOMAIN=$api" "FRONTEND_ORIGIN=$origin" "${cloudflare[@]}"
      if [[ ${#cloudflare[@]} -gt 0 ]]; then
        echo "Cloudflare mode is on. Next: in Cloudflare, add a proxied (orange cloud) DNS record for $api"
        echo "pointing at this server, then run: sudo ./nullbin start"
      else
        echo "Next: point $api at this server, then run: sudo ./nullbin start"
      fi
      ;;
    cloudflare)
      layout
      local want=${1:-status} current=${settings[CLOUDFLARE]:-false}
      [[ $# -le 1 ]] || die "usage: sudo ./nullbin cloudflare [on | off]"
      case $want in
        status)
          cloudflare_status
          exit 0
          ;;
        on)
          if [[ $current == true ]]; then
            echo "Cloudflare mode is already on."
            cloudflare_status
            exit 0
          fi
          set_setting CLOUDFLARE=true
          ;;
        off)
          if [[ $current != true ]]; then
            echo "Cloudflare mode is already off."
            exit 0
          fi
          # Off is the default, so the setting is removed rather than set to false.
          set_setting CLOUDFLARE=
          ;;
        *) die "usage: sudo ./nullbin cloudflare [on | off]" ;;
      esac
      settings=()
      check_config
      start
      cloudflare_status
      ;;
    start)
      layout
      start
      ;;
    update)
      layout
      local target current changes
      current=$(installed)
      if [[ $# -ge 1 ]]; then
        target=$1
      else
        target=$(latest_release || true)
        [[ -n $target ]] || die "could not look up the latest release. Check that this server can reach github.com, or give a version from the Releases page: sudo ./nullbin update v1.2.3"
      fi
      [[ $target =~ ^v[0-9]+[.][0-9]+[.][0-9]+$ ]] || die "not a release version: $target (expected something like v1.2.3)"
      echo "Installed: $current"
      echo "Target:    $target"
      # Git refuses to move a release tag that already exists here, so a tag
      # changed on GitHub after release is never followed.
      g fetch --quiet --tags origin "+refs/heads/main:refs/remotes/origin/main" ||
        echo "Could not fetch new releases (see the message above); using releases already downloaded."
      g rev-parse --quiet --verify "refs/tags/$target^{commit}" >/dev/null || die "release $target was not found"
      # Only a published release from the main branch is installed, never a
      # tag pushed by mistake or by someone who took over an account.
      if [[ ${NULLBIN_TEST_UNRELEASED:-} == 1 ]]; then
        echo "NULLBIN_TEST_UNRELEASED=1: not checking that $target is a release (for testing only)." >&2
      else
        g merge-base --is-ancestor "refs/tags/$target^{commit}" refs/remotes/origin/main 2>/dev/null ||
          die "$target is not on Nullbin's main branch, so it is not a release"
        case $(release_status "$target") in
          200) ;;
          404) die "$target is not a published release. See the Releases page on GitHub." ;;
          *) echo "Could not ask GitHub whether $target is a published release; installing it because it is on the main branch." >&2 ;;
        esac
      fi
      # Edited files would be overwritten, and files added to the checkout
      # would be built into Nullbin along with the release. The settings
      # file is ignored by Git and checked separately.
      changes=$(local_changes)
      [[ -z $changes ]] || die "the checkout has files that did not come with Nullbin, which the update would overwrite or build in:
$changes
See them with: git -C $repo status --ignored
Set them aside with: git -C $repo stash --include-untracked (and move ignored ones elsewhere)"
      local previous snapshot=$deploy/$config.before-update
      previous=$(g rev-parse HEAD)
      as_owner cp -p -- "$deploy/$config" "$snapshot"
      g -c advice.detachedHead=false checkout --quiet "$target"
      # Start with the release's own copy of this script, so changes to how
      # Nullbin starts take effect with the update that brings them.
      if "$deploy/nullbin" start; then
        as_owner rm -f -- "$snapshot"
        exit 0
      fi
      # Remove everything the failed version started, then put back the
      # code and the settings exactly as they were.
      echo "nullbin: $target did not start; going back to $current." >&2
      "${compose[@]}" down --remove-orphans || true
      g -c advice.detachedHead=false checkout --quiet "$previous"
      as_owner cp -p -- "$snapshot" "$deploy/$config"
      as_owner rm -f -- "$snapshot"
      "$deploy/nullbin" start || die "$current did not start either. See what went wrong with: sudo ./nullbin logs"
      die "the update to $target failed, and $current is running again. See what went wrong with: sudo ./nullbin logs"
      ;;
    status)
      layout
      echo "Running version:   $(running)"
      echo "Checked-out code:  $(installed)"
      if [[ ${settings[CLOUDFLARE]:-false} == true ]]; then
        echo "Cloudflare mode:   on (details: sudo ./nullbin cloudflare)"
      else
        echo "Cloudflare mode:   off"
      fi
      "${compose[@]}" ps
      ;;
    logs)
      layout
      local lines=${1:-100}
      [[ $lines =~ ^[0-9]{1,6}$ ]] || die "give a number of lines, such as: sudo ./nullbin logs 200"
      "${compose[@]}" logs --tail "$lines"
      ;;
    stop)
      layout
      "${compose[@]}" down
      echo "Stopped. Pastes are kept; start again with: sudo ./nullbin start"
      ;;
    delete)
      layout
      local id=${1:-}
      [[ $id =~ ^[0-9a-f]{32}$ ]] || die "give the paste ID: the 32 characters after /p/ or /d/ in its link, without the part after #"
      "${compose[@]}" stop nullbin
      local status=0
      "${compose[@]}" run --rm --no-deps nullbin delete "$id" || status=$?
      "${compose[@]}" start nullbin
      return "$status"
      ;;
    cleanup)
      # Unused images and the build cache only; never volumes, so never pastes.
      docker image prune -f
      docker builder prune -f
      echo "Done. Pastes are never affected; the next update rebuilds a little more slowly."
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

usage() {
  # The comment at the top of this file, up to the end of its command list.
  awk 'NR > 1 { if (/^#$/ && listed) exit; if (/sudo \.\/nullbin /) listed = 1; print }' "${BASH_SOURCE[0]}" | cut -c 3-
}

main "$@"
exit
