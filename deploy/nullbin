#!/usr/bin/env bash
# Nullbin server helper. Run it with sudo from the deploy folder:
#
#   sudo ./nullbin setup paste.example.com    configure the one-server layout
#   sudo ./nullbin setup-api api.example.com https://paste.example.com
#                                             configure the separate-API layout
#   sudo ./nullbin start            build and start the installed release
#   sudo ./nullbin update           update to the latest release
#   sudo ./nullbin update v1.2.3    switch to a specific release (or back to one)
#   sudo ./nullbin status           installed version and container status
#   sudo ./nullbin logs             recent logs
#   sudo ./nullbin stop             stop Nullbin (pastes are kept)
#   sudo ./nullbin delete <id>      remove a reported paste by its ID
#   sudo ./nullbin cleanup          free disk space used by old builds
#
# Option A uses deploy/.env and Option B deploy/.env.api; every command picks
# the right one. Git and all file changes run as the owner of the checkout,
# so sudo never leaves root-owned files behind.
#
# Whoever can change this checkout controls what runs as root here, as with
# any Docker Compose setup: keep it owned and writable by you alone.
set -euo pipefail

# Everything runs inside main, which bash reads completely before running:
# "update" replaces this file with the new release's copy while it runs.
main() {
  local deploy repo owner
  deploy=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  repo=$(dirname -- "$deploy")

  die() { echo "nullbin: $*" >&2; exit 1; }

  [[ $# -ge 1 ]] || { usage; exit 2; }
  local cmd=$1
  shift
  [[ $cmd == help || $cmd == -h || $cmd == --help ]] && { usage; exit 0; }
  [[ $EUID -eq 0 ]] || die "run it with sudo: sudo ./nullbin $cmd $*"
  [[ -d $repo/.git ]] || die "$repo is not a Git checkout of Nullbin"

  # Runs a command as the checkout's owner. Every file this script reads,
  # creates or changes inside the checkout goes through it: as root, a link
  # planted there could redirect the operation to a system file. Git runs
  # this way too, so the files it writes stay the owner's.
  owner=$(stat -c %U -- "$repo/.git")
  as_owner() {
    if [[ $owner == root ]]; then
      "$@"
    else
      sudo -u "$owner" -- "$@"
    fi
  }
  g() { as_owner git -C "$repo" "$@"; }

  # Which layout: Option A (.env) or Option B (.env.api).
  local -a compose=()
  layout() {
    if [[ -f $deploy/.env && -f $deploy/.env.api ]]; then
      die "both deploy/.env and deploy/.env.api exist; remove the one you do not use"
    elif [[ -f $deploy/.env ]]; then
      compose=(docker compose -f "$deploy/compose.yaml")
    elif [[ -f $deploy/.env.api ]]; then
      compose=(docker compose --env-file "$deploy/.env.api" -f "$deploy/compose.api.yaml")
    else
      die "not configured yet: run sudo ./nullbin setup paste.example.com (or setup-api for the separate-API layout)"
    fi
  }

  # A lowercase domain name with at least one dot, or localhost for testing.
  valid_domain() {
    local d=$1
    [[ $d == localhost ]] && return 0
    [[ ${#d} -le 253 && $d =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?[.])+[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]
  }

  # Copies standard input to standard output, replacing whole lines that
  # start with a setting's name (such as DOMAIN=) by that setting.
  render_config() {
    local line setting
    while IFS= read -r line || [[ -n $line ]]; do
      for setting in "$@"; do
        if [[ $line == "${setting%%=*}="* ]]; then
          line=$setting
        fi
      done
      printf '%s\n' "$line"
    done
  }

  # Writes a configuration file from its example with the given settings.
  # The file belongs to the checkout's owner and only they can read it.
  write_config() {
    local example=$1 target=$2
    shift 2
    [[ ! -e $deploy/.env && ! -e $deploy/.env.api ]] ||
      die "already configured: edit deploy/.env or deploy/.env.api, or delete it to start over"
    local tmp setting found
    # Only the text passes through root; every file operation is the owner's.
    tmp=$(as_owner mktemp "$deploy/.config.XXXXXX")
    if ! as_owner cat -- "$deploy/$example" | render_config "$@" | as_owner tee -- "$tmp" >/dev/null; then
      as_owner rm -f -- "$tmp"
      die "could not read $example"
    fi
    for setting in "$@"; do
      found=$(as_owner grep -c -F -x -- "$setting" "$tmp" || true)
      [[ $found -eq 1 ]] || { as_owner rm -f -- "$tmp"; die "could not set ${setting%%=*} in $example"; }
    done
    as_owner chmod 600 -- "$tmp"
    as_owner mv -- "$tmp" "$deploy/$target"
    echo "Wrote deploy/$target. To change settings later, edit it and run: sudo ./nullbin start"
  }

  installed() { g describe --tags --always 2>/dev/null || echo unknown; }

  start() {
    local version
    version=$(installed)
    echo "Building and starting Nullbin $version. The first build takes a few minutes."
    VERSION=$version "${compose[@]}" up -d --build --wait --wait-timeout 600
    echo "Nullbin $version is running."
  }

  latest_release() {
    local url slug
    url=$(g remote get-url origin)
    url=${url%.git}
    url=${url%/}
    slug=${url#https://github.com/}
    slug=${slug#git@github.com:}
    [[ $slug =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
    curl -fsSL "https://api.github.com/repos/$slug/releases/latest" |
      grep -o '"tag_name": *"[^"]*"' | head -n 1 | cut -d '"' -f 4
  }

  case $cmd in
    setup)
      local domain=${1:-}
      domain=${domain,,}
      valid_domain "$domain" ||
        die "give your domain name only, such as: sudo ./nullbin setup paste.example.com (no https:// and no slash)"
      write_config env.example .env "DOMAIN=$domain"
      echo "Next: point $domain at this server, then run: sudo ./nullbin start"
      ;;
    setup-api)
      local api=${1:-} origin=${2:-} host port
      api=${api,,}
      origin=${origin,,}
      valid_domain "$api" ||
        die "usage: sudo ./nullbin setup-api api.example.com https://paste.example.com (the API's domain name, then the website's exact address)"
      [[ $origin == https://* ]] || die "the website address must start with https://, such as https://paste.example.com"
      host=${origin#https://}
      port=
      if [[ $host == *:* ]]; then
        port=${host##*:}
        host=${host%:*}
        [[ $port =~ ^[1-9][0-9]{0,4}$ && $port -le 65535 && $port -ne 443 ]] ||
          die "invalid port in $origin (leave out :443)"
      fi
      valid_domain "$host" ||
        die "the website address must be https:// and a domain name, with no path or trailing slash, such as https://paste.example.com"
      write_config env.api.example .env.api "API_DOMAIN=$api" "FRONTEND_ORIGIN=$origin"
      echo "Next: point $api at this server, then run: sudo ./nullbin start"
      ;;
    start)
      layout
      start
      ;;
    update)
      layout
      local target current changes
      current=$(installed)
      if [[ $# -ge 1 ]]; then
        target=$1
      else
        target=$(latest_release || true)
        [[ -n $target ]] || die "could not look up the latest release. Check that this server can reach github.com, or give a version from the Releases page: sudo ./nullbin update v1.2.3"
      fi
      [[ $target =~ ^v[0-9]+[.][0-9]+[.][0-9]+$ ]] || die "not a release version: $target (expected something like v1.2.3)"
      echo "Installed: $current"
      echo "Target:    $target"
      # Git refuses to move a release tag that already exists here, so a tag
      # changed on GitHub after release is never followed.
      g fetch --quiet --tags origin || echo "Could not fetch new releases (see the message above); using releases already downloaded."
      g rev-parse --quiet --verify "refs/tags/$target^{commit}" >/dev/null || die "release $target was not found"
      changes=$(g status --porcelain --untracked-files=no)
      [[ -z $changes ]] || die "files that came with Nullbin were edited, so the update would overwrite them:
$changes
See them with: git -C $repo diff
Set them aside with: git -C $repo stash"
      g -c advice.detachedHead=false checkout --quiet "$target"
      start
      ;;
    status)
      layout
      echo "Installed version: $(installed)"
      "${compose[@]}" ps
      ;;
    logs)
      layout
      local lines=${1:-100}
      [[ $lines =~ ^[0-9]{1,6}$ ]] || die "give a number of lines, such as: sudo ./nullbin logs 200"
      "${compose[@]}" logs --tail "$lines"
      ;;
    stop)
      layout
      "${compose[@]}" down
      echo "Stopped. Pastes are kept; start again with: sudo ./nullbin start"
      ;;
    delete)
      layout
      local id=${1:-}
      [[ $id =~ ^[0-9a-f]{32}$ ]] || die "give the paste ID: the 32 characters after /p/ or /d/ in its link, without the part after #"
      "${compose[@]}" stop nullbin
      local status=0
      "${compose[@]}" run --rm --no-deps nullbin delete "$id" || status=$?
      "${compose[@]}" start nullbin
      return "$status"
      ;;
    cleanup)
      # Unused images and the build cache only; never volumes, so never pastes.
      docker image prune -f
      docker builder prune -f
      echo "Done. Pastes are never affected; the next update rebuilds a little more slowly."
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

usage() {
  sed -n '2,14p' "${BASH_SOURCE[0]}" | cut -c 3-
}

main "$@"
exit
