# Cloudflare mode (CLOUDFLARE=true): Cloudflare's proxy is in front of this
# server. Imported by Caddyfile and Caddyfile.api.
#
# Cloudflare's published ranges: https://www.cloudflare.com/ips/
# CI fails when they no longer match this list. Keep both lists identical.

# Inside the global servers block. Only a connection from Cloudflare may
# name the visitor's address, and only in CF-Connecting-IP, which
# Cloudflare sets itself. Everyone else's headers are ignored.
(edge-servers) {
	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	client_ip_headers CF-Connecting-IP
}

# Inside the site block.
(edge-site) {
	# Let's Encrypt first. If it cannot issue a certificate, Caddy uses one
	# from its own local authority, which Cloudflare's "Full" SSL mode
	# accepts. That one lasts an hour, and each renewal (about every 40
	# minutes) tries Let's Encrypt again. Visitors only ever see Cloudflare's
	# certificate.
	tls {
		issuer acme
		issuer internal {
			lifetime 1h
		}
	}
	# Everything must come through Cloudflare. Docker's published ports skip
	# host firewalls such as ufw, so this check is what keeps the server
	# from answering anyone else directly.
	@not-cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @not-cloudflare {
		respond "This site is served only through Cloudflare." 403
	}
}
