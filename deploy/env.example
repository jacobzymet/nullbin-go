# Copy this file to .env (cp env.example .env) and edit it.

# Required. Your domain, for example DOMAIN=paste.example.com. Its DNS A
# record (and AAAA, if the server has IPv6) must point at this server before
# you start, so the HTTPS certificate can be issued.
DOMAIN=

# Largest paste, from 64KiB up to 2GiB.
MAX_SIZE=100MiB

# Total reserved storage. Set below the volume capacity, leaving room for
# the OS, filesystem overhead, container images and other applications.
MAX_STORAGE=10GiB
# Maximum number of unfinished uploads. An upload expires after 2 minutes
# without progress (1 hour at most).
MAX_PENDING=1024
# Most pastes at once (about four inodes each). Raise it only if the
# volume has inodes to spare: df -i
MAX_PASTES=100000
