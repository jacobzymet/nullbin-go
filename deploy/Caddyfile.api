# Caddy terminates HTTPS for Nullbin. It gets and renews certificates
# automatically (Let's Encrypt or ZeroSSL) once DOMAIN points at this server.
# Access logging is off (Caddy's default without a `log` directive): URLs
# contain paste IDs.

# Direct (CLOUDFLARE=false) or behind Cloudflare's proxy (true, or
# self-signed to never use Let's Encrypt):
# which proxies may name the visitor's address, and how certificates are
# obtained. See caddy/cloudflare-*.caddy.
import /etc/caddy/nullbin/cloudflare-{$CLOUDFLARE:false}.caddy

# Global options. (This comment also keeps caddy fmt from joining the
# block to the import line above, which would change its meaning.)
{
	# No admin API; restart the container to reload this file.
	admin off
	# HTTP/1.1 and HTTP/2 only. HTTP/3 would add a whole protocol stack
	# (QUIC over UDP) for little benefit here; browsers fall back by themselves.
	servers {
		protocols h1 h2
		# A client gets 10 seconds to send its request headers. Nullbin itself
		# limits how slowly a body may arrive.
		timeouts {
			read_header 10s
		}
		import edge-servers
	}
	# Never try to add Caddy's local test CA to the container's trust store.
	skip_install_trust
	# Never enable the debug option here: at debug level Caddy logs every
	# client address, in message text that no filter can remove. CI checks
	# that the default level logs none.
	# Runtime errors also include request headers, even without access
	# logging. Remove the entire request, including custom capability tokens,
	# paste IDs, client addresses and user agents, from the default logger.
	log default {
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}
}

{$DOMAIN} {
	# No request_body limit: the Nullbin API caps every request body
	# itself, and request_body in Caddy builds made with Go before 1.27.4
	# lets an oversized body crash Caddy (CVE-2026-97054).
	# Security headers for every response, including those Caddy makes
	# itself: not found, request too large, the API unreachable, and the
	# Cloudflare-only refusal.
	header {
		Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; sandbox"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
	}
	header -Server
	header -Via
	import edge-site
	handle /api/v1/* {
		reverse_proxy 172.30.53.20:8080 {
			# Exactly one address: the visitor's, as Caddy determined it. Nullbin
			# trusts this header only from Caddy, so nothing a client or another
			# proxy adds can reach it.
			header_up X-Forwarded-For {client_ip}
			# The site sets these for every response (above). The API's own
			# copies are dropped: a header sent twice, such as
			# Cross-Origin-Resource-Policy, can be ignored by browsers.
			header_down -Content-Security-Policy
			header_down -Referrer-Policy
			header_down -X-Content-Type-Options
			header_down -X-Frame-Options
			header_down -Cross-Origin-Opener-Policy
			header_down -Cross-Origin-Resource-Policy
			header_down -Strict-Transport-Security
			header_down -Service-Worker-Allowed
			header_down -Set-Cookie
		}
	}
	handle {
		respond "Not found" 404
	}
}
