# Option B: API on this server; frontend hosted somewhere else.
# Copy to .env.api and replace the two example addresses below.

# Point this domain at your API server.
API_DOMAIN=api.example.com

# The exact address people use to open Nullbin. Include https://.
# No trailing slash or path. Preview/alternate domains are not allowed.
FRONTEND_ORIGIN=https://paste.example.com

MAX_SIZE=100MiB
MAX_STORAGE=10GiB
MAX_PENDING=1024
