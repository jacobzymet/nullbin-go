# Do not auto-install peer dependencies (Bootstrap declares @popperjs/core,
# which Nullbin does not use: it ships Bootstrap CSS only).
legacy-peer-deps=true
# Never run dependency install scripts. CI and Docker also pass --ignore-scripts.
ignore-scripts=true
# Pin exact versions when adding dependencies.
save-exact=true
# Fail on lockfile/engine mismatch rather than silently resolving.
engine-strict=true
audit-level=low
fund=false
